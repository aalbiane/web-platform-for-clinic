
@{
    ViewData["Title"] = "Главная";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Поликлиника Альбас</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"  rel="stylesheet" />
</head>
<body>

    <!-- Header -->
    <header class="bg-light py-3 mb-4 shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <h1 class="mb-0 text-primary">Поликлиника Альбас</h1>
            <div>
                <a href="/register/index" class="btn btn-outline-primary me-2">Регистрация</a>
                <a href="/login/index" class="btn btn-primary">Войти</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container my-5">
        <!-- Welcome Section -->
        <section class="text-center mb-5">
            <h2 class="mb-4">Добро пожаловать в Поликлинику Альбас!</h2>

            <!-- Image after heading -->
            <img src="~/images/klinika.jpg" alt="Поликлиника Альбас" class="img-fluid rounded shadow-sm mb-4" style="max-height: 1000px; object-fit: cover; width: 100%;">

            <p class="lead">
                Мы предоставляем качественные медицинские услуги для жителей города.
                Наши опытные врачи и современное оборудование обеспечивают высокий уровень диагностики и лечения.
            </p>
        </section>

        <!-- About Section -->
        <section>
            <h3 class="mb-4">Наша поликлиника — это современный медицинский центр, где забота о вашем здоровье становится приоритетом.</h3>
            <p class="mb-4">
                Мы объединяем высокий профессионализм врачей, передовые технологии и индивидуальный подход к каждому пациенту.
            </p>

            <h4>Почему выбирают нас?</h4>
            <ul class="list-unstyled mt-3">
                <li class="mb-2">
                    <span class="fw-bold">✔ Квалифицированные специалисты</span> — у нас работают опытные врачи, которые регулярно повышают свою квалификацию.
                </li>
                <li class="mb-2">
                    <span class="fw-bold">✔ Комфорт и забота</span> — мы создали уютную атмосферу, чтобы посещение поликлиники было максимально приятным.
                </li>
                <li class="mb-2">
                    <span class="fw-bold">✔ Современное оборудование</span> — точная диагностика и эффективное лечение благодаря новейшим медицинским технологиям.
                </li>
                <li class="mb-2">
                    <span class="fw-bold">✔ Доступность</span> — гибкий график работы, удобная запись и внимательное отношение к каждому.
                </li>
            </ul>

            <p class="mt-4">
                Мы стремимся сделать медицину более человечной, а ваше здоровье — крепким. Доверьтесь нам, и вместе мы сохраним самое ценное!
            </p>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4 mt-auto">
        <div class="container">
            <p class="mb-0">&copy; 2025 — Поликлиника Альбас</p>
            <p class="mb-0">Адрес: г. Казань, ул. Деревня Универсиады, д. 3</p>
            <p>Телефон: +7 (986) 925 77-79</p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> 
</body>
</html>
